# Local API server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL / Neon
# Use the pooled Neon URL for runtime queries and the direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# Generate a strong random secret (at least 32 random bytes).
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Public Panchayat self-registration is enabled for local development only.
# In production leave this false and onboard Panchayats through an approved process.
ALLOW_PUBLIC_REGISTRATION=true

# Cookie settings. Keep lax for local development / same-site hosting.
# For a frontend and API on different sites, set COOKIE_SAME_SITE=none and COOKIE_SECURE=true;
# HTTPS is required when SameSite=None is used.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
